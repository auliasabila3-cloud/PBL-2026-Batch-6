let text = " hello world! ";
console.log(`text = ${text}`);
let length = text.length;
console.log(`length = ${length}`);
let text1 = text.charAt(2);
console.log(`charAt = ${text1}`);
let text2 = text.slice(2, 4);
console.log(`slice = ${text2}`);
let text3 = text.substring(2, 5);
console.log(`substring = ${text3}`);
let text4 = text.toUpperCase();
console.log(`toUpperCase = ${text4}`);
let text5 = text.toLowerCase();
console.log(`toLowerCase = ${text5}`);
let text6 = text1.concat(" ", text2);
console.log(`concat = ${text6}`);
let text7 = text.trim();
console.log(`trim = ${text7}`);
let text8 = text.split(" ");
console.log(`split = ${text8}`);
let text9 = text.replace("world", "dunia");
console.log(`replace = ${text9}`);
let text10 = text.slice(-2);
console.log(`slice = ${text10}`);